    "genesis.polar",
    "genesis.posterize",
    "genesis.radial-blur",
    "genesis.ripple",
    "genesis.rotate",
    "genesis.rounded-corners",
    "genesis.saturation",
    "genesis.scanlines",
    "genesis.scratches",
    "genesis.screen-tear",
    "genesis.sepia",
    "genesis.shadows-highlights",
    "genesis.sharpen",
    "genesis.signal-loss",
    "genesis.solarize",
    "genesis.spin-blur",
    "genesis.split-tone",
    "genesis.spotlight",
    "genesis.squeeze",
    "genesis.stipple",
    "genesis.swirl",
    "genesis.technicolor",
    "genesis.temperature",
