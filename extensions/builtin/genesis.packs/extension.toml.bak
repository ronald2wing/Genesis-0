# The builtin data-only extension that ships the official effect-pack set.
# There is no `entry`: the extension contributes only its bundled packs (the
# 123 `packs/genesis.*` directories beside this manifest), which the host
# collects as the builtin catalogue's pack root.

[extension]
id = "genesis.packs"
name = "Genesis Effect Packs"
kind = "content"
version = 1
api = 1
packs = [
    "genesis.ascii",
    "genesis.bleach-bypass",
    "genesis.bloom",
    "genesis.bloom-pulse",
    "genesis.blur",
    "genesis.border",
    "genesis.brightness-contrast-saturation",
    "genesis.bulge",
    "genesis.cartoon",
    "genesis.channel-mixer",
    "genesis.channel-swap",
    "genesis.chromatic-aberration",
    "genesis.clarity",
    "genesis.color-balance",
    "genesis.colorize",
    "genesis.comic",
    "genesis.contrast",
    "genesis.crosshatch",
    "genesis.crt",
    "genesis.cubism",
    "genesis.curves",
    "genesis.datamosh",
    "genesis.denoise",
    "genesis.denoise-audio",
    "genesis.directional-blur",
    "genesis.dither",
    "genesis.dream",
    "genesis.drop-shadow",
    "genesis.duotone",
    "genesis.dust",
    "genesis.echo",
    "genesis.edge-glow",
    "genesis.edges",
    "genesis.emboss",
    "genesis.exposure",
    "genesis.fade",
    "genesis.false-color",
    "genesis.film-fade",
    "genesis.film-grain",
    "genesis.filmic",
    "genesis.fisheye",
    "genesis.flip",
    "genesis.gaussian-blur",
    "genesis.glitch",
    "genesis.glow",
    "genesis.god-rays",
    "genesis.gradient-tint",
    "genesis.grayscale",
    "genesis.grunge",
    "genesis.halftone",
    "genesis.halo",
    "genesis.hue",
    "genesis.hue-saturation-lightness",
    "genesis.inner-shadow",
    "genesis.invert",
    "genesis.kaleidoscope",
    "genesis.lens-distortion",
    "genesis.lens-flare",
    "genesis.letterbox",
    "genesis.levels",
    "genesis.lift-gamma-gain",
    "genesis.light-leak",
    "genesis.light-streaks",
    "genesis.loudness",
    "genesis.lut-grade",
    "genesis.mirror",
    "genesis.mosaic",
    "genesis.motion-blur",
    "genesis.neon",
    "genesis.noir",
    "genesis.noise",
    "genesis.oil-paint",
    "genesis.outline",
    "genesis.paper",
    "genesis.pastel",
    "genesis.pencil-sketch",
    "genesis.perspective",
