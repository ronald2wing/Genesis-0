// The fragment BODY; see genesis.exposure/effect.glsl for the contract.

void main () {
    vec4 c = texture2D (tex, v_texcoord);
    float l = dot (c.rgb, vec3 (0.2126, 0.7152, 0.0722));
    float g = step (threshold, l);
    gl_FragColor = vec4 (vec3 (g), c.a);
}
